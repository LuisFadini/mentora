{
  "name": "projeto-integrador",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @mentora/api --filter @mentora/frontend dev",
    "dev:api": "pnpm --filter @mentora/api dev",
    "dev:web": "pnpm --filter @mentora/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "drizzle-kit": "pnpm --filter @mentora/api drizzle-kit"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.5.2",
  "lint-staged": {
    "*.ts": "eslint --fix",
    "apps/frontend/**/*.{js,ts,svelte,css}": [
      "pnpm --dir apps/frontend exec eslint --fix",
      "pnpm --dir apps/frontend exec prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.3.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}