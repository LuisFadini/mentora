{
  "name": "projeto-integrador",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @mentora/api --filter @mentora/frontend dev",
    "dev:api": "pnpm --filter @mentora/api dev",
    "dev:web": "pnpm --filter @mentora/frontend dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "postinstall": "pnpm build:packages",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "drizzle-kit": "pnpm --filter @mentora/api drizzle-kit"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.5.2",
  "lint-staged": {
    "*.ts": "eslint --fix",
    "apps/frontend/**/*.{js,ts,svelte,css}": [
      "pnpm --dir apps/frontend exec eslint --fix",
      "pnpm --dir apps/frontend exec prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
